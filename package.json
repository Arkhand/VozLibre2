{
  "name": "vozlibre2",
  "version": "1.0.0",
  "private": true,
  "description": "Píldora flotante de transcripción de voz (Groq Whisper) para Windows: ventana frameless, transparente y always-on-top que se expande al transcribir.",
  "author": "Daniel Musial",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node assets/make-icon.js",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^26.6.10",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "com.danielmusial.vozlibre2",
    "productName": "VozLibre2",
    "icon": "assets/icon.ico",
    "files": [
      "main.js",
      "src/**/*",
      "!src/**/*.ps1",
      "assets/icon.ico"
    ],
    "extraResources": [
      {
        "from": "src/type-unicode.ps1",
        "to": "type-unicode.ps1"
      }
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
